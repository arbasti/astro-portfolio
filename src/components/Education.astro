---
import { getCollection } from "astro:content";

const educationEntries = await getCollection("education");
const entries = educationEntries
  .map((entry) => entry.data)
  .sort((a, b) => a.order - b.order);
---

<section
  id="education"
  class="relative overflow-hidden px-6 py-24 md:px-12 md:py-32"
>
  <h2 class="reveal mb-16 font-display text-3xl font-bold text-ink md:mb-20 md:text-4xl">
    Education
  </h2>

  <div class="relative mx-auto max-w-4xl">
    <div class="absolute left-4 top-0 bottom-0 w-px bg-ink/15 md:left-1/2 md:-translate-x-1/2"></div>

    <div class="flex flex-col gap-20 md:gap-28">
      {entries.map((entry, i) => (
        <div
          class="timeline-entry reveal relative"
          data-theme={entry.theme}
          data-page-theme={entry.theme}
          style={`transition-delay: ${i * 150}ms;`}
        >
          <span
            class="absolute left-4 top-2 h-3.5 w-3.5 -translate-x-1/2 rounded-full md:left-1/2"
            style={`background: ${entry.accent};`}
          />

          <div
            class={`pl-12 md:pl-0 ${
              entry.wide
                ? "md:w-[calc(72%-2.75rem)] md:mx-auto"
                : `md:w-[calc(50%-2.75rem)] ${i % 2 === 0 ? "md:mr-auto" : "md:ml-auto"}`
            }`}
          >
            <div
              class="rounded-2xl border bg-white/70 p-6 backdrop-blur-sm"
              style={`border-color: ${entry.accent}33;`}
            >
              <div class="mb-4 -mt-2 -mx-2 overflow-hidden rounded-xl">
                <img
                  src={entry.image}
                  alt={entry.imageAlt}
                  loading="lazy"
                  decoding="async"
                  class="h-40 w-full object-cover md:h-48"
                />
              </div>

              <p
                class="text-xs font-semibold uppercase tracking-widest"
                style={`color: ${entry.accent};`}
              >
                {entry.meta}
              </p>
              <h3 class="mt-2 font-display text-xl font-bold text-ink">
                {entry.title}
              </h3>
              <p class="mt-1 text-sm font-semibold text-ink/80">
                {entry.subtitle}
              </p>
              <p class="mt-3 text-sm leading-relaxed text-ink/65">
                {entry.description}
              </p>

              <p class="mt-4 text-xs font-semibold uppercase tracking-wide text-ink/50">
                Courses & focus
              </p>
              <p class="mt-1 text-sm leading-relaxed text-ink/65">
                {entry.highlights}
              </p>

              {entry.project && (
                <p class="mt-3 text-sm leading-relaxed text-ink/65">
                  <span class="font-semibold text-ink/80">Project — </span>
                  {entry.project}
                </p>
              )}

              {entry.story && (
                <p
                  class="mt-4 border-l-2 pl-3 text-sm italic leading-relaxed text-ink/70"
                  style={`border-color: ${entry.accent};`}
                >
                  {entry.story}
                </p>
              )}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
