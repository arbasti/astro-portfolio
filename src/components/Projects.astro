---
import { getCollection } from "astro:content";

const projectEntries = await getCollection("projects");
const projects = projectEntries
  .map((entry) => entry.data)
  .sort((a, b) => a.order - b.order);

const sizeClasses: Record<string, string> = {
  sm: "md:col-span-1",
  lg: "md:col-span-2",
};

const statusBadges: Record<string, { label: string; classes: string }> = {
  completed: { label: "Completed", classes: "bg-[#DCEEDD] text-[#1F6B3A]" },
  "in-progress": { label: "In progress", classes: "bg-[#FCE4D6] text-[#C1441E]" },
  "on-hold": { label: "On hold", classes: "bg-[#EFE6FE] text-[#a476f5]" },
};
---

<section
  id="projects"
  data-page-theme="projects"
  class="mx-auto max-w-7xl px-6 py-24 md:px-12 md:py-32"
>
  <h2 class="reveal mb-16 font-display text-3xl font-bold text-ink md:mb-20 md:text-4xl">
    Projects
  </h2>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-4 md:grid-flow-dense">
    {projects.map((project, i) => (
      <div
        class={`reveal group relative flex flex-col overflow-hidden rounded-2xl transition-all duration-300 ease-out hover:z-10 hover:-translate-y-1 hover:scale-[1.02] hover:shadow-xl hover:shadow-ink/10 ${sizeClasses[project.size]} ${
          project.spotlight
            ? "border-2 border-accent bg-accent/5"
            : "border border-ink/10 bg-card/60"
        }`}
        style={`transition-delay: ${i * 80}ms;`}
      >
        <div class="relative flex h-40 items-center justify-center overflow-hidden bg-ink/5 text-sm text-ink/40">
          {project.size === "lg" && project.images.length >= 2 ? (
            <div class="absolute inset-0 grid grid-cols-2 gap-1">
              <img
                src={project.images[0]}
                alt={`${project.title} — screenshot 1`}
                loading="lazy"
                decoding="async"
                class="h-full w-full min-h-0 min-w-0 object-cover"
              />
              <div
                class="swipe-gallery relative h-full min-h-0 min-w-0 overflow-hidden"
                data-images={JSON.stringify(project.images.slice(1))}
              >
                <img
                  src={project.images[1]}
                  alt={`${project.title} — screenshot 2`}
                  loading="lazy"
                  decoding="async"
                  class="swipe-img absolute inset-0 h-full w-full object-cover transition-transform duration-500 ease-out"
                />
                {project.images.length > 2 && (
                  <div class="pointer-events-none absolute bottom-2 left-1/2 z-10 flex -translate-x-1/2 gap-1.5">
                    {project.images.slice(1).map((_, idx) => (
                      <span
                        class={`gallery-dot h-1.5 w-1.5 rounded-full transition-colors ${idx === 0 ? "bg-white" : "bg-white/50"}`}
                      />
                    ))}
                  </div>
                )}
              </div>
            </div>
          ) : project.images.length > 0 ? (
            <div
              class="swipe-gallery absolute inset-0 overflow-hidden"
              data-images={JSON.stringify(project.images)}
            >
              <img
                src={project.images[0]}
                alt={project.title}
                loading="lazy"
                decoding="async"
                class="swipe-img absolute inset-0 h-full w-full object-cover transition-transform duration-500 ease-out"
              />
              {project.images.length > 1 && (
                <div class="pointer-events-none absolute bottom-2 left-1/2 z-10 flex -translate-x-1/2 gap-1.5">
                  {project.images.map((_, idx) => (
                    <span
                      class={`gallery-dot h-1.5 w-1.5 rounded-full transition-colors ${idx === 0 ? "bg-white" : "bg-white/50"}`}
                    />
                  ))}
                </div>
              )}
            </div>
          ) : (
            <span>[Project image]</span>
          )}

          <span
            class={`absolute left-3 top-3 rounded-full px-3 py-1 text-xs font-semibold ${statusBadges[project.status].classes}`}
          >
            {statusBadges[project.status].label}
          </span>
        </div>

        <div class="flex flex-1 flex-col p-6">
          <h3 class="font-display text-lg font-bold text-ink">
            {project.title}
          </h3>
          {project.duration && (
            <p class="mt-1 text-xs text-ink/50">{project.duration}</p>
          )}

          <p class="project-desc mt-3 line-clamp-5 text-sm leading-relaxed text-ink/65">
            {project.description}
          </p>
          <button
            type="button"
            class="project-desc-toggle group/more mt-2 hidden items-center gap-1 self-start text-sm font-semibold text-accent underline decoration-accent/40 underline-offset-4 transition-colors hover:decoration-accent"
            aria-haspopup="dialog"
            data-dialog={`project-dialog-${i}`}
          >
            Read more
            <svg
              class="h-4 w-4 transition-transform duration-300 group-hover/more:translate-x-0.5"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M5 12h14M13 6l6 6-6 6" />
            </svg>
          </button>

          <div class="mt-4 flex flex-wrap gap-2">
            {project.tags.map((tag) => (
              <span class="rounded-full border border-accent/30 px-3 py-1 text-xs font-semibold text-accent">
                {tag}
              </span>
            ))}
          </div>

          <div class="mt-auto flex justify-end gap-4 pt-5 opacity-40 transition-opacity duration-300 group-hover:opacity-100">
            {project.github && (
              <a
                href={project.github}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="View source code on GitHub"
                class="text-ink/70 hover:text-ink"
              >
                <svg
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                >
                  <path d="M12 2C6.48 2 2 6.58 2 12.19c0 4.49 2.87 8.3 6.84 9.64.5.1.68-.22.68-.48 0-.24-.01-.87-.01-1.71-2.78.62-3.37-1.36-3.37-1.36-.45-1.18-1.11-1.49-1.11-1.49-.91-.64.07-.63.07-.63 1 .07 1.53 1.05 1.53 1.05.89 1.56 2.34 1.11 2.91.85.09-.66.35-1.11.63-1.37-2.22-.26-4.56-1.14-4.56-5.06 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.31.1-2.72 0 0 .84-.28 2.75 1.05a9.3 9.3 0 0 1 5 0c1.91-1.33 2.75-1.05 2.75-1.05.55 1.41.2 2.46.1 2.72.64.72 1.03 1.63 1.03 2.75 0 3.93-2.35 4.79-4.58 5.05.36.32.68.94.68 1.9 0 1.37-.01 2.48-.01 2.82 0 .27.18.59.69.48A10.02 10.02 0 0 0 22 12.19C22 6.58 17.52 2 12 2z" />
                </svg>
              </a>
            )}
            {project.website && (
              <a
                href={project.website}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Visit live website"
                class="text-ink/70 hover:text-ink"
              >
                <svg
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                >
                  <circle cx="12" cy="12" r="10" />
                  <path d="M2 12h20M12 2a15 15 0 0 1 0 20M12 2a15 15 0 0 0 0 20" />
                </svg>
              </a>
            )}
            {project.brief && (
              <a
                href={project.brief}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="View project brief"
                class="text-ink/70 hover:text-ink"
              >
                <svg
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                >
                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                  <path d="M14 2v6h6" />
                </svg>
              </a>
            )}
            {project.slides && (
              <a
                href={project.slides}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="View presentation slides"
                class="text-ink/70 hover:text-ink"
              >
                <svg
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                >
                  <rect x="2" y="4" width="20" height="14" rx="2" />
                  <path d="M8 21h8M12 18v3" />
                </svg>
              </a>
            )}
          </div>
        </div>
      </div>
    ))}
  </div>

  {projects.map((project, i) => {
    const links = [
      { href: project.github, label: "GitHub" },
      { href: project.website, label: "Website" },
      { href: project.brief, label: "Brief" },
      { href: project.slides, label: "Slides" },
    ].filter((link) => link.href);
    return (
      <dialog
        id={`project-dialog-${i}`}
        class="project-dialog m-auto w-[calc(100%-2rem)] max-w-2xl overflow-hidden rounded-2xl border border-ink/10 bg-bg p-0 text-ink shadow-2xl shadow-ink/20"
        aria-labelledby={`project-dialog-title-${i}`}
      >
        <div class="flex max-h-[85vh] flex-col">
          {project.images.length > 0 && (
            <div class="relative h-44 shrink-0 bg-ink/5 md:h-56">
              <img
                src={project.images[0]}
                alt=""
                loading="lazy"
                decoding="async"
                class="h-full w-full object-cover"
              />
            </div>
          )}

          <div class="overflow-y-auto p-6 md:p-8">
            <div class="flex items-start justify-between gap-4">
              <div>
                <span
                  class={`inline-block rounded-full px-3 py-1 text-xs font-semibold ${statusBadges[project.status].classes}`}
                >
                  {statusBadges[project.status].label}
                </span>
                <h3
                  id={`project-dialog-title-${i}`}
                  class="mt-3 font-display text-2xl font-bold text-ink"
                >
                  {project.title}
                </h3>
                {project.duration && (
                  <p class="mt-1 text-sm text-ink/50">{project.duration}</p>
                )}
              </div>
              <form method="dialog">
                <button
                  class="rounded-full p-2 text-ink/60 transition-colors hover:bg-ink/10 hover:text-ink"
                  aria-label="Close"
                >
                  <svg
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    aria-hidden="true"
                  >
                    <path d="M18 6 6 18M6 6l12 12" />
                  </svg>
                </button>
              </form>
            </div>

            <p class="mt-5 text-base leading-relaxed text-ink/75">
              {project.description}
            </p>

            <div class="mt-6 flex flex-wrap gap-2">
              {project.tags.map((tag) => (
                <span class="rounded-full border border-accent/30 px-3 py-1 text-xs font-semibold text-accent">
                  {tag}
                </span>
              ))}
            </div>

            {links.length > 0 && (
              <div class="mt-6 flex flex-wrap gap-3 border-t border-ink/10 pt-5">
                {links.map((link) => (
                  <a
                    href={link.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="rounded-full bg-accent px-4 py-2 text-sm font-semibold text-bg transition-opacity hover:opacity-85"
                  >
                    {link.label} ↗
                  </a>
                ))}
              </div>
            )}
          </div>
        </div>
      </dialog>
    );
  })}
</section>
<script>
  document
    .querySelectorAll<HTMLElement>(".swipe-gallery")
    .forEach((container) => {
      const images: string[] = JSON.parse(container.dataset.images || "[]");
      if (images.length < 2) return;

      let currentIndex = 0;
      let currentImg = container.querySelector<HTMLImageElement>(".swipe-img")!;
      let timer: ReturnType<typeof setInterval> | null = null;

      function updateDots(index: number) {
        container
          .querySelectorAll<HTMLElement>(".gallery-dot")
          .forEach((dot, i) => {
            dot.classList.toggle("bg-white", i === index);
            dot.classList.toggle("bg-white/50", i !== index);
          });
      }

      function next() {
        const nextIndex = (currentIndex + 1) % images.length;
        const incoming = document.createElement("img");
        incoming.src = images[nextIndex];
        incoming.alt = currentImg.alt;
        incoming.loading = "lazy";
        incoming.decoding = "async";
        incoming.className = currentImg.className;
        incoming.style.transform = "translateX(100%)";
        container.appendChild(incoming);

        // Force the browser to acknowledge the starting position
        // before we change it, otherwise the transition is randomly skipped.
        void incoming.offsetWidth;

        currentImg.style.transform = "translateX(-100%)";
        incoming.style.transform = "translateX(0%)";

        const outgoing = currentImg;
        outgoing.addEventListener(
          "transitionend",
          () => {
            outgoing.remove();
          },
          { once: true },
        );

        currentImg = incoming;
        currentIndex = nextIndex;
        updateDots(currentIndex);
      }

      const card = container.closest<HTMLElement>(".group");
      card?.addEventListener("mouseenter", () => {
        timer = setInterval(next, 1400);
      });
      card?.addEventListener("mouseleave", () => {
        if (timer) clearInterval(timer);
        timer = null;
      });
    });

  // Long descriptions are clamped to keep cards a similar height;
  // the toggle only appears when the text actually overflows.
  const descToggles = document.querySelectorAll<HTMLButtonElement>(
    ".project-desc-toggle",
  );

  function updateDescToggles() {
    descToggles.forEach((button) => {
      const desc = button.previousElementSibling as HTMLElement;
      const overflows = desc.scrollHeight > desc.clientHeight;
      button.classList.toggle("hidden", !overflows);
      button.classList.toggle("inline-flex", overflows);
      desc.classList.toggle("is-clamped", overflows);
    });
  }

  // "Read more" opens the full project in a modal dialog.
  descToggles.forEach((button) => {
    const dialog = document.getElementById(
      button.dataset.dialog!,
    ) as HTMLDialogElement | null;
    if (!dialog) return;
    button.addEventListener("click", () => dialog.showModal());
  });

  // Close a dialog when clicking on the backdrop, outside its box.
  document
    .querySelectorAll<HTMLDialogElement>(".project-dialog")
    .forEach((dialog) => {
      // The content wrapper fills the dialog, so a click whose target is
      // the dialog itself can only come from the backdrop.
      dialog.addEventListener("click", (event) => {
        if (event.target === dialog) dialog.close();
      });
    });

  updateDescToggles();
  window.addEventListener("resize", updateDescToggles);
</script>

<style>
  /* Fade the last clamped line so it reads as "there's more below". */
  .project-desc.is-clamped {
    -webkit-mask-image: linear-gradient(to bottom, #000 60%, transparent);
    mask-image: linear-gradient(to bottom, #000 60%, transparent);
  }

  .project-dialog {
    opacity: 0;
    transform: translateY(12px) scale(0.98);
    transition:
      opacity 0.25s ease-out,
      transform 0.25s ease-out,
      overlay 0.25s allow-discrete,
      display 0.25s allow-discrete;
  }

  .project-dialog[open] {
    opacity: 1;
    transform: none;
  }

  @starting-style {
    .project-dialog[open] {
      opacity: 0;
      transform: translateY(12px) scale(0.98);
    }
  }

  .project-dialog::backdrop {
    background: rgb(0 0 0 / 0);
    backdrop-filter: blur(0);
    transition:
      background 0.25s ease-out,
      backdrop-filter 0.25s ease-out,
      overlay 0.25s allow-discrete,
      display 0.25s allow-discrete;
  }

  .project-dialog[open]::backdrop {
    background: rgb(0 0 0 / 0.45);
    backdrop-filter: blur(4px);
  }

  @starting-style {
    .project-dialog[open]::backdrop {
      background: rgb(0 0 0 / 0);
      backdrop-filter: blur(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-dialog,
    .project-dialog::backdrop {
      transition: none;
    }
  }

  /* Keep the page from scrolling behind an open dialog. */
  :global(html:has(dialog[open])) {
    overflow: hidden;
  }
</style>
