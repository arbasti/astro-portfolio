---
const projects = [
  {
    title: "This portfolio",
    description:
      "The site you're on right now — built from scratch with Astro and Tailwind, featuring a scroll-driven timeline, an ambient color system, and a playable Snake game.",
    status: "in-progress",
    duration: null,
    tags: ["Astro", "Tailwind", "TypeScript"],
    images: [
      "./projects/astro-portfolio/astro-portfolio.png",
      "./projects/astro-portfolio/astro-portfolio.png",
    ],
    github: "https://github.com/arbasti/astro-portfolio",
    website: null,
    brief: null,
    slides: null,
    size: "lg",
    spotlight: true,
  },
  {
    title: "webtech-109",
    description:
      "A full-stack monorepo built during my web technologies coursework — Node/Express API, React/Next.js frontend, Supabase for storage.",
    status: "completed",
    duration: "1 semester",
    tags: ["Node.js", "Express", "Next.js", "Supabase", "Tailwind"],
    images: [
      "./projects/webtech-109/home.png",
      "./projects/webtech-109/profile.png",
    ],
    github: "https://github.com/arbasti/webtech-109",
    website: "https://webtech-109.vercel.app/",
    brief: null,
    slides: null,
    size: "sm",
    spotlight: false,
  },
  {
    title: "Solar inverter cyberattacks (PPE)",
    description:
      "A multidisciplinary team project (Projet Pluridisciplinaire en Équipe) at ECE Paris, investigating cybersecurity vulnerabilities in solar inverter systems.",
    status: "completed",
    duration: null,
    tags: ["Cybersecurity", "Research"],
    images: ["./projects/2ASICYA/2ASICYA.png"],
    github: null,
    website: null,
    brief: null,
    slides: null,
    size: "sm",
    spotlight: false,
  },

  // Add your next project here — just copy this shape:
  // {
  //   title: "",
  //   description: "",
  //   status: "completed" | "in-progress",
  //   duration: "",
  //   tags: [],
  //   images: ["/projects/your-image.jpg"] or null,
  //   github: "https://..." or null,
  //   brief: "/projects/your-brief.pdf" or null,
  //   slides: "/projects/your-slides.pdf" or null,
  //   size: "sm" | "md" | "lg",
  // },
];

const sizeClasses: Record<string, string> = {
  sm: "md:col-span-1",
  lg: "md:col-span-2",
};
---

<section
  id="projects"
  data-page-theme="projects"
  class="mx-auto max-w-7xl px-6 py-24 md:px-12 md:py-32"
>
  <h2 class="mb-16 font-display text-3xl font-bold text-ink md:mb-20 md:text-4xl">
    Projects
  </h2>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-4 md:[grid-auto-flow:dense]">
    {projects.map((project) => (
      <div
        class={`group relative flex flex-col overflow-hidden rounded-2xl transition-all duration-300 ease-out hover:z-10 hover:-translate-y-1 hover:scale-[1.02] hover:shadow-xl hover:shadow-ink/10 ${sizeClasses[project.size]} ${
          project.spotlight
            ? "border-2 border-accent bg-accent/5"
            : "border border-ink/10 bg-card/60"
        }`}
      >
        <div class="relative flex h-40 items-center justify-center bg-ink/5 text-sm text-ink/40">
          {project.size === "lg" && project.images.length >= 2 ? (
            <div class="grid h-full w-full grid-cols-2 gap-1">
              <img
                src={project.images[0]}
                alt={`${project.title} — screenshot 1`}
                loading="lazy"
                decoding="async"
                class="h-full w-full object-cover"
              />
              <div
                class="swipe-gallery relative h-full w-full overflow-hidden"
                data-images={JSON.stringify(project.images.slice(1))}
              >
                <img
                  src={project.images[1]}
                  alt={`${project.title} — screenshot 2`}
                  loading="lazy"
                  decoding="async"
                  class="swipe-img absolute inset-0 h-full w-full object-cover transition-transform duration-500 ease-out"
                />
                {project.images.length > 2 && (
                  <div class="pointer-events-none absolute bottom-2 left-1/2 z-10 flex -translate-x-1/2 gap-1.5">
                    {project.images.slice(1).map((_, idx) => (
                      <span
                        class={`gallery-dot h-1.5 w-1.5 rounded-full transition-colors ${idx === 0 ? "bg-white" : "bg-white/50"}`}
                      />
                    ))}
                  </div>
                )}
              </div>
            </div>
          ) : project.images.length > 0 ? (
            <div
              class="swipe-gallery relative h-full w-full overflow-hidden"
              data-images={JSON.stringify(project.images)}
            >
              <img
                src={project.images[0]}
                alt={project.title}
                loading="lazy"
                decoding="async"
                class="swipe-img absolute inset-0 h-full w-full object-cover transition-transform duration-500 ease-out"
              />
              {project.images.length > 1 && (
                <div class="pointer-events-none absolute bottom-2 left-1/2 z-10 flex -translate-x-1/2 gap-1.5">
                  {project.images.map((_, idx) => (
                    <span
                      class={`gallery-dot h-1.5 w-1.5 rounded-full transition-colors ${idx === 0 ? "bg-white" : "bg-white/50"}`}
                    />
                  ))}
                </div>
              )}
            </div>
          ) : (
            <span>[Project image]</span>
          )}

          <span
            class={`absolute left-3 top-3 rounded-full px-3 py-1 text-xs font-semibold ${
              project.status === "completed"
                ? "bg-[#DCEEDD] text-[#1F6B3A]"
                : "bg-[#FCE4D6] text-[#C1441E]"
            }`}
          >
            {project.status === "completed" ? "Completed" : "In progress"}
          </span>
        </div>

        <div class="flex flex-1 flex-col p-6">
          <h3 class="font-display text-lg font-bold text-ink">
            {project.title}
          </h3>
          {project.duration && (
            <p class="mt-1 text-xs text-ink/50">{project.duration}</p>
          )}

          <p class="mt-3 text-sm leading-relaxed text-ink/65">
            {project.description}
          </p>

          <div class="mt-4 flex flex-wrap gap-2">
            {project.tags.map((tag) => (
              <span class="rounded-full border border-accent/30 px-3 py-1 text-xs font-semibold text-accent">
                {tag}
              </span>
            ))}
          </div>

          <div class="mt-auto flex justify-end gap-4 pt-5 opacity-40 transition-opacity duration-300 group-hover:opacity-100">
            {project.github && (
              <a
                href={project.github}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="View source code on GitHub"
                class="text-ink/70 hover:text-ink"
              >
                <svg
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                >
                  <path d="M12 2C6.48 2 2 6.58 2 12.19c0 4.49 2.87 8.3 6.84 9.64.5.1.68-.22.68-.48 0-.24-.01-.87-.01-1.71-2.78.62-3.37-1.36-3.37-1.36-.45-1.18-1.11-1.49-1.11-1.49-.91-.64.07-.63.07-.63 1 .07 1.53 1.05 1.53 1.05.89 1.56 2.34 1.11 2.91.85.09-.66.35-1.11.63-1.37-2.22-.26-4.56-1.14-4.56-5.06 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.31.1-2.72 0 0 .84-.28 2.75 1.05a9.3 9.3 0 0 1 5 0c1.91-1.33 2.75-1.05 2.75-1.05.55 1.41.2 2.46.1 2.72.64.72 1.03 1.63 1.03 2.75 0 3.93-2.35 4.79-4.58 5.05.36.32.68.94.68 1.9 0 1.37-.01 2.48-.01 2.82 0 .27.18.59.69.48A10.02 10.02 0 0 0 22 12.19C22 6.58 17.52 2 12 2z" />
                </svg>
              </a>
            )}
            {project.website && (
              <a
                href={project.website}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Visit live website"
                class="text-ink/70 hover:text-ink"
              >
                <svg
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                >
                  <circle cx="12" cy="12" r="10" />
                  <path d="M2 12h20M12 2a15 15 0 0 1 0 20M12 2a15 15 0 0 0 0 20" />
                </svg>
              </a>
            )}
            {project.brief && (
              <a
                href={project.brief}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="View project brief"
                class="text-ink/70 hover:text-ink"
              >
                <svg
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                >
                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                  <path d="M14 2v6h6" />
                </svg>
              </a>
            )}
            {project.slides && (
              <a
                href={project.slides}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="View presentation slides"
                class="text-ink/70 hover:text-ink"
              >
                <svg
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                >
                  <rect x="2" y="4" width="20" height="14" rx="2" />
                  <path d="M8 21h8M12 18v3" />
                </svg>
              </a>
            )}
          </div>
        </div>
      </div>
    ))}
  </div>
</section>
<script>
  document
    .querySelectorAll<HTMLElement>(".swipe-gallery")
    .forEach((container) => {
      const images: string[] = JSON.parse(container.dataset.images || "[]");
      if (images.length < 2) return;

      let currentIndex = 0;
      let currentImg = container.querySelector<HTMLImageElement>(".swipe-img")!;
      let timer: ReturnType<typeof setInterval> | null = null;

      function updateDots(index: number) {
        container
          .querySelectorAll<HTMLElement>(".gallery-dot")
          .forEach((dot, i) => {
            dot.classList.toggle("bg-white", i === index);
            dot.classList.toggle("bg-white/50", i !== index);
          });
      }

      function next() {
        const nextIndex = (currentIndex + 1) % images.length;
        const incoming = document.createElement("img");
        incoming.src = images[nextIndex];
        incoming.alt = currentImg.alt;
        incoming.loading = "lazy";
        incoming.decoding = "async";
        incoming.className = currentImg.className;
        incoming.style.transform = "translateX(100%)";
        container.appendChild(incoming);

        // Force the browser to acknowledge the starting position
        // before we change it, otherwise the transition is randomly skipped.
        void incoming.offsetWidth;

        currentImg.style.transform = "translateX(-100%)";
        incoming.style.transform = "translateX(0%)";

        const outgoing = currentImg;
        outgoing.addEventListener(
          "transitionend",
          () => {
            outgoing.remove();
          },
          { once: true },
        );

        currentImg = incoming;
        currentIndex = nextIndex;
        updateDots(currentIndex);
      }

      const card = container.closest<HTMLElement>(".group");
      card?.addEventListener("mouseenter", () => {
        timer = setInterval(next, 1400);
      });
      card?.addEventListener("mouseleave", () => {
        if (timer) clearInterval(timer);
        timer = null;
      });
    });
</script>
