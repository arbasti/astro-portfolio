---
---

<section class="mx-auto max-w-6xl px-6 md:px-12 py-16 md:py-24">
  <p class="text-xs md:text-sm uppercase tracking-[0.2em] font-semibold text-accent mb-10 md:mb-14">
    Portfolio — Bastian Ardillon
  </p>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-10 md:gap-16">
    <!-- Left column: photo + snake, offset like bricks -->
    <div class="flex flex-col gap-8">
      <div class="aspect-[3/4] md:aspect-auto md:h-[420px] rounded-2xl bg-card overflow-hidden">
        <img
          src="/me.jpeg"
          alt="photo of me"
          class="w-full h-full object-cover"
        />
      </div>

      <div class="md:ml-16 rounded-2xl bg-ink text-bg p-7">
        <h3 class="font-display font-semibold text-lg">Skills</h3>
        <p class="text-xs text-bg/50 mt-1">
          the snake collects them one by one
        </p>

        <div class="flex gap-1.5 mt-5">
          <span class="w-8 h-8 rounded-lg bg-accent"></span>
          <span class="w-8 h-8 rounded-lg bg-accent"></span>
          <span class="w-8 h-8 rounded-lg bg-accent"></span>
          <span class="w-8 h-8 rounded-lg bg-[#C1441E]"></span>
          <span class="w-8 h-8 rounded-lg border-2 border-dashed border-bg/30"></span>
          <span class="w-8 h-8 rounded-lg border-2 border-dashed border-bg/30"></span>
        </div>

        <div class="flex flex-wrap gap-2 mt-4">
          <span class="text-xs font-semibold px-3 py-1.5 rounded-full bg-accent text-bg">
            Python
          </span>
          <span class="text-xs font-semibold px-3 py-1.5 rounded-full bg-accent text-bg">
            Java
          </span>
          <span class="text-xs font-semibold px-3 py-1.5 rounded-full bg-accent text-bg">
            SQL
          </span>
          <span class="text-xs font-semibold px-3 py-1.5 rounded-full bg-[#C1441E] text-bg">
            Linux
          </span>
          <span class="text-xs font-semibold px-3 py-1.5 rounded-full border border-dashed border-ink/20 text-ink/40">
            DevOps
          </span>
          <span class="text-xs font-semibold px-3 py-1.5 rounded-full border border-dashed border-ink/20 text-ink/40">
            Arduino
          </span>
        </div>
      </div>
    </div>

    <!-- Right column: description + stats, offset the same way -->
    <div class="flex flex-col gap-8 md:pt-10">
      <div class="flex flex-col gap-5">
        <h1 class="font-display font-bold text-4xl md:text-5xl leading-tight">
          Bastian Ardillon
        </h1>
        <p class="font-display font-semibold text-lg md:text-xl text-accent">
          Computer Science Engineering Student — Cybersecurity
        </p>
        <p class="text-base leading-relaxed text-ink/70 max-w-md">
          Computer Science engineering student at ECE Paris, specializing in
          cybersecurity. I like building things that work — and occasionally
          things that just look cool, like the snake game below. Outside of
          code, you'll find me learning languages (currently obsessing over
          Korean) or planning my next trip.
        </p>
        <div class="flex items-center gap-3 mt-2">
          <a
            href="/Bastian_Ardillon_CV.pdf"
            download
            class="bg-ink text-bg px-6 py-3.5 rounded-lg font-semibold text-sm"
          >
            Download my CV
          </a>

          <a
            href="https://linkedin.com/in/bastian-ardillon"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="LinkedIn profile"
            class="w-12 h-12 rounded-lg border border-ink flex items-center justify-center hover:bg-ink hover:text-bg transition-colors"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
              <path d="M20.45 20.45h-3.55v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.36V9h3.41v1.56h.05c.47-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45z" />
            </svg>
          </a>

          <a
            href="https://github.com/arbasti"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="GitHub profile"
            class="w-12 h-12 rounded-lg border border-ink flex items-center justify-center hover:bg-ink hover:text-bg transition-colors"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2C6.48 2 2 6.58 2 12.19c0 4.49 2.87 8.3 6.84 9.64.5.1.68-.22.68-.48 0-.24-.01-.87-.01-1.71-2.78.62-3.37-1.36-3.37-1.36-.45-1.18-1.11-1.49-1.11-1.49-.91-.64.07-.63.07-.63 1 .07 1.53 1.05 1.53 1.05.89 1.56 2.34 1.11 2.91.85.09-.66.35-1.11.63-1.37-2.22-.26-4.56-1.14-4.56-5.06 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.31.1-2.72 0 0 .84-.28 2.75 1.05a9.3 9.3 0 0 1 5 0c1.91-1.33 2.75-1.05 2.75-1.05.55 1.41.2 2.46.1 2.72.64.72 1.03 1.63 1.03 2.75 0 3.93-2.35 4.79-4.58 5.05.36.32.68.94.68 1.9 0 1.37-.01 2.48-.01 2.82 0 .27.18.59.69.48A10.02 10.02 0 0 0 22 12.19C22 6.58 17.52 2 12 2z" />
            </svg>
          </a>
        </div>
      </div>

      <div class="md:mr-16 rounded-2xl border-2 border-dashed border-ink/20 bg-card flex items-center justify-center text-center px-8 py-14">
        <span class="text-sm text-ink/50">
          [Stats coming soon — Wakatime or other]
        </span>
      </div>
    </div>
  </div>
</section>
