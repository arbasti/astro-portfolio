---
import { getCollection } from "astro:content";

const skillEntries = await getCollection("skills");
const skills = skillEntries.map((entry) => entry.data);

const GRID_COLS = 18;
const GRID_ROWS = 10;
---

<section
  id="skills"
  data-page-theme="skills"
  class="mx-auto max-w-7xl px-6 py-24 md:px-12 md:py-32"
>
  <h2 class="reveal mb-16 font-display text-3xl font-bold text-ink md:mb-20 md:text-4xl">
    Skills
  </h2>

  <div class="flex flex-col gap-8 md:flex-row md:items-start">
    <div class="rounded-2xl border border-ink/10 bg-ink p-4 md:p-6">
      <div
        id="snake-grid"
        class="grid gap-0.5"
        style={`grid-template-columns: repeat(${GRID_COLS}, minmax(0, 1fr)); width: min(85vw, 560px); aspect-ratio: ${GRID_COLS} / ${GRID_ROWS};`}
      >
        {Array.from({ length: GRID_COLS * GRID_ROWS }).map((_, i) => (
          <div class="relative aspect-square rounded-sm bg-white/5">
            <div class="cell-fill absolute inset-0.5 rounded-sm bg-accent opacity-0 transition-opacity duration-150" />
            <div class="apple-slot absolute inset-[15%] h-[70%] w-[70%] opacity-0 transition-opacity duration-200" />
            <div
              class="victory-fill absolute inset-0.5 rounded-sm opacity-0 transition-opacity duration-300"
              style="background: #f19d61;"
            />
          </div>
        ))}
      </div>
    </div>

    <div class="flex flex-1 flex-col gap-2">
      <div id="skill-checklist" class="grid grid-cols-3 gap-2">
        {skills.map((_, i) => (
          <div
            id={`skill-slot-${i}`}
            class="flex h-11 items-center gap-2 rounded-lg border border-dashed border-ink/20 px-2 transition-all duration-300"
          />
        ))}
      </div>
    </div>
  </div>
</section>

<script define:vars={{ GRID_COLS, GRID_ROWS, skills }}>
  const SPEED_MULTIPLIER = 1; // 0.5, 1, 1.5, or 2
  const STEP_MS = 180 / SPEED_MULTIPLIER;

  const SQL_SVG = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><ellipse cx="12" cy="5" rx="8" ry="3"/><path d="M4 5v14c0 1.66 3.58 3 8 3s8-1.34 8-3V5"/><path d="M4 12c0 1.66 3.58 3 8 3s8-1.34 8-3"/></svg>`;
  const DEVOPS_SVG = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M18 12a4 4 0 1 1-4-4 6 6 0 0 0 4 4Z"/><path d="M6 12a4 4 0 1 0 4 4 6 6 0 0 1-4-4Z"/></svg>`;
  const LLM_SVG = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"><path d="M10 3l1.8 5.2L17 10l-5.2 1.8L10 17l-1.8-5.2L3 10l5.2-1.8Z"/><path d="M18 14l.9 2.1L21 17l-2.1.9L18 20l-.9-2.1L15 17l2.1-.9Z"/></svg>`;

  function iconMarkup(icon, cssClass) {
    if (icon === "svg:sql")
      return `<span class="${cssClass}">${SQL_SVG}</span>`;
    if (icon === "svg:devops")
      return `<span class="${cssClass}">${DEVOPS_SVG}</span>`;
    if (icon === "svg:llm")
      return `<span class="${cssClass}">${LLM_SVG}</span>`;
    return `<img src="${icon}" alt="" class="${cssClass}" />`;
  }

  const grid = document.getElementById("snake-grid");
  const cells = Array.from(grid.querySelectorAll(":scope > div"));
  const cellAt = (r, c) => cells[r * GRID_COLS + c];

  function shuffle(arr) {
    const a = [...arr];
    for (let i = a.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [a[i], a[j]] = [a[j], a[i]];
    }
    return a;
  }

  let snake,
    direction,
    apple,
    appleSkillIndex,
    remainingSkills,
    filledSlots,
    gameOver;

  function resetGame() {
    gameOver = false;
    cells.forEach((cell) => {
      cell.querySelector(".victory-fill").style.opacity = "0";
    });
    snake = [
      { r: 4, c: 3 },
      { r: 4, c: 2 },
      { r: 4, c: 1 },
    ];
    direction = { r: 0, c: 1 };
    remainingSkills = shuffle(skills.map((_, i) => i));
    filledSlots = 0;
    for (let i = 0; i < skills.length; i++) {
      document.getElementById(`skill-slot-${i}`).innerHTML = "";
      document.getElementById(`skill-slot-${i}`).className =
        "flex h-11 items-center gap-2 rounded-lg border border-dashed border-ink/20 px-2 transition-all duration-300";
    }
    cells.forEach((cell) => {
      cell.querySelector(".cell-fill").style.opacity = "0";
      cell.querySelector(".apple-slot").style.opacity = "0";
      cell.querySelector(".apple-slot").innerHTML = "";
    });
    spawnApple();
  }

  function spawnApple() {
    const occupied = new Set(snake.map((s) => `${s.r},${s.c}`));
    let r, c;
    do {
      r = Math.floor(Math.random() * GRID_ROWS);
      c = Math.floor(Math.random() * GRID_COLS);
    } while (occupied.has(`${r},${c}`));
    apple = { r, c };
    appleSkillIndex = remainingSkills.pop();
    const slot = cellAt(r, c).querySelector(".apple-slot");
    slot.innerHTML = iconMarkup(
      skills[appleSkillIndex].icon,
      "h-full w-full object-contain text-white",
    );
    slot.style.opacity = "1";
  }

  function chooseDirection() {
    const options = [
      { r: -1, c: 0 },
      { r: 1, c: 0 },
      { r: 0, c: -1 },
      { r: 0, c: 1 },
    ];
    const head = snake[snake.length - 1];
    const bodySet = new Set(snake.slice(1).map((s) => `${s.r},${s.c}`)); // tail excluded, it moves away

    const safe = options
      .map((d) => ({ d, next: { r: head.r + d.r, c: head.c + d.c } }))
      .filter(
        ({ next }) =>
          next.r >= 0 &&
          next.r < GRID_ROWS &&
          next.c >= 0 &&
          next.c < GRID_COLS &&
          !bodySet.has(`${next.r},${next.c}`),
      )
      .sort(
        (a, b) =>
          Math.abs(a.next.r - apple.r) +
          Math.abs(a.next.c - apple.c) -
          (Math.abs(b.next.r - apple.r) + Math.abs(b.next.c - apple.c)),
      );

    return safe.length > 0 ? safe[0].d : direction;
  }

  function playVictoryWave() {
    const diagonalCount = GRID_ROWS + GRID_COLS - 1;
    const WAVE_STEP_MS = 35;

    for (let d = 0; d < diagonalCount; d++) {
      setTimeout(() => {
        for (let r = 0; r < GRID_ROWS; r++) {
          const c = d - r;
          if (c >= 0 && c < GRID_COLS) {
            cellAt(r, c).querySelector(".victory-fill").style.opacity = "1";
          }
        }
      }, d * WAVE_STEP_MS);
    }
  }

  function tick() {
    direction = chooseDirection();
    const head = snake[snake.length - 1];
    const next = { r: head.r + direction.r, c: head.c + direction.c };
    snake.push(next);

    const ateApple = next.r === apple.r && next.c === apple.c;

    if (!ateApple) {
      const removed = snake.shift();
      cellAt(removed.r, removed.c).querySelector(".cell-fill").style.opacity =
        "0";
    } else {
      cellAt(next.r, next.c).querySelector(".apple-slot").style.opacity = "0";

      const slot = document.getElementById(`skill-slot-${filledSlots}`);
      slot.innerHTML = `
        <span class="flex h-5 w-5 items-center justify-center">${iconMarkup(skills[appleSkillIndex].icon, "h-5 w-5 object-contain text-ink")}</span>
        <span class="text-xs font-semibold text-ink">${skills[appleSkillIndex].name}</span>
      `;
      slot.className =
        "flex h-11 items-center gap-2 rounded-lg border border-ink/10 bg-card/60 px-2 transition-all duration-300";
      filledSlots++;

      if (filledSlots >= skills.length) {
        gameOver = true;
        playVictoryWave();
        setTimeout(() => {
          resetGame();
          requestAnimationFrame(loop);
        }, 4000);
        return;
      }
      spawnApple();
    }

    snake.forEach((seg) => {
      cellAt(seg.r, seg.c).querySelector(".cell-fill").style.opacity = "1";
    });
  }

  let lastTime = 0;
  function loop(time) {
    if (!gameOver && time - lastTime >= STEP_MS) {
      tick();
      lastTime = time;
    }
    requestAnimationFrame(loop);
  }

  resetGame();
  const observer = new IntersectionObserver(
    ([entry]) => {
      if (entry.isIntersecting) requestAnimationFrame(loop);
    },
    { threshold: 0.2 },
  );
  observer.observe(document.getElementById("skills"));
</script>
